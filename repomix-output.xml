                {/* Cash Drawer input if Cash payment is chosen */}
                {paymentMethod === 'cash' && (
                  <motion.div 
                    initial={{ opacity: 0, height: 0 }}
                    animate={{ opacity: 1, height: 'auto' }}
                    className="space-y-2"
                  >
                    <label className="block text-xs font-semibold text-gray-500">
                      Amount Handed Cash
